SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# stub | voyage | openai — production value decided by ADR 0003
EMBEDDINGS_PROVIDER=stub
VOYAGE_API_KEY=
OPENAI_API_KEY=
# Answer assembly (/api/ask, issue #21)
ANTHROPIC_API_KEY=
# Anthropic model id; empty = claude-sonnet-5 (SPEC §5: Sonnet by default)
ANSWER_MODEL=
# off | voyage — Voyage rerank-2.5-lite over the retrieval pool (#21 design
# note); leave off until #25 validates the lift. voyage needs VOYAGE_API_KEY.
RERANK=off
# Rate limiting (SPEC §7) — anon/authed daily question limits, both optional
RATE_LIMIT_ANON=
RATE_LIMIT_AUTHED=
# Auth (issue #23) — browser-safe pair; local values come from `supabase status -o env`
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# GitHub OAuth app (callback: <SUPABASE_URL>/auth/v1/callback) — read by supabase/config.toml
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=
# Google OAuth client (same callback; basic scopes only — issue #84) — read by supabase/config.toml
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
