SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# stub | voyage — the whole list, and a privacy contract (#209): a provider
# reachable from here is one a dashboard env var can select with no PR and no
# deploy, so it must be one /privacidad names. Production value: ADR 0003.
EMBEDDINGS_PROVIDER=stub
VOYAGE_API_KEY=
# Answer assembly (/api/ask, issue #21)
ANTHROPIC_API_KEY=
# Anthropic model id; empty = claude-sonnet-5 (SPEC §5: Sonnet by default)
ANSWER_MODEL=
# Anthropic model id for the multi-turn question condensation step (ADR-0012);
# empty = claude-haiku-4-5 — a bad rewrite falls back to the raw question, so
# this step does not need Sonnet.
CONDENSE_MODEL=
# off | voyage — Voyage rerank-2.5-lite over the retrieval pool (#21 design
# note); leave off until #25 validates the lift. voyage needs VOYAGE_API_KEY.
RERANK=off
# Rate limiting (SPEC §7) — anon/authed daily question limits, both optional
RATE_LIMIT_ANON=
RATE_LIMIT_AUTHED=
# REQUIRED (#125). HMAC key for the anonymous rate-limit subject, so the stored
# subject can't be recomputed by anyone who knows an IP and a browser family.
# Any high-entropy string: `openssl rand -hex 32`. Server-only — never expose
# it to the browser. Without it every anonymous ask fails closed with a 503.
# Rotating it re-keys today's anonymous subjects, so quotas already spent today
# start over — harmless, and the old rows age out on their own. The quota day
# itself is the Costa Rica calendar day (UTC-6), not UTC.
RATE_LIMIT_SUBJECT_SECRET=
# Auth (issue #23) — browser-safe pair; local values come from `supabase status -o env`
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# GitHub OAuth app (callback: <SUPABASE_URL>/auth/v1/callback) — read by supabase/config.toml
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=
# Google OAuth client (same callback; basic scopes only — issue #84) — read by supabase/config.toml
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
# Production SMTP (issue #85, executed with #29) — Resend or Postmark, free
# tier is ample. Only used by the hosted project's Auth settings; local dev
# keeps `supabase start`'s Inbucket/Mailpit capture regardless of these.
# Uncomment [auth.email.smtp] in supabase/config.toml before pushing to prod.
SMTP_PASS=
SMTP_ADMIN_EMAIL=
