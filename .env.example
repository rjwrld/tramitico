SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# stub | voyage — the whole list, and a privacy contract (#209): a provider
# reachable from here is one a dashboard env var can select with no PR and no
# deploy, so it must be one /privacidad names. Production value: ADR 0003.
EMBEDDINGS_PROVIDER=stub
VOYAGE_API_KEY=
# Answer assembly (/api/ask, issue #21)
# Production uses a key from its own Anthropic workspace, `tramitico-prod`,
# with a US$10 monthly spend limit set in the Console (#327, runbook §7): the
# per-subject daily quota bounds one user, the cap bounds the crowd. Local
# development and eval.yml use a key from a *separate* workspace, so a paid
# eval run can neither be blocked by the cap nor spend production's budget.
# Never put the prod key in this file's local copy.
ANTHROPIC_API_KEY=
# Anthropic model id; empty = claude-sonnet-5 (SPEC §5: Sonnet by default)
ANSWER_MODEL=
# Anthropic model id for the multi-turn question condensation step (ADR-0012);
# empty = claude-haiku-4-5 — a bad rewrite falls back to the raw question, so
# this step does not need Sonnet.
CONDENSE_MODEL=
# off | voyage — Voyage rerank-2.5-lite over the retrieval pool (#21 design
# note); leave off until #25 validates the lift. voyage needs VOYAGE_API_KEY.
RERANK=off
# on | off — the query-expansion legs (ADR-0019): one small model call rewrites
# the question into the register of the corpus and its two legs join the
# fusion. Default on, and off means exactly the search v4 performed, which is
# what to set when comparing against a pre-#286 number. Needs
# ANTHROPIC_API_KEY; without one it is off whatever this says.
EXPAND=
# Anthropic model id for that rewrite; empty = claude-haiku-4-5. Separate from
# CONDENSE_MODEL on purpose: this call runs in front of *every* ask, so one
# knob for both would hide which of the two a cost change came from.
EXPAND_MODEL=
# Rate limiting (SPEC §7) — anon/authed daily question limits, both optional
RATE_LIMIT_ANON=
RATE_LIMIT_AUTHED=
# REQUIRED (#125). HMAC key for the anonymous rate-limit subject, so the stored
# subject can't be recomputed by anyone who knows an IP and a browser family.
# Any high-entropy string: `openssl rand -hex 32`. Server-only — never expose
# it to the browser. Without it every anonymous ask fails closed with a 503.
# Rotating it re-keys today's anonymous subjects, so quotas already spent today
# start over — harmless, and the old rows age out on their own. The quota day
# itself is the Costa Rica calendar day (UTC-6), not UTC.
RATE_LIMIT_SUBJECT_SECRET=
# Auth (issue #23) — browser-safe pair; local values come from `supabase status -o env`
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# GitHub OAuth app (callback: <SUPABASE_URL>/auth/v1/callback) — read by supabase/config.toml
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=
# Google OAuth client (same callback; basic scopes only — issue #84) — read by supabase/config.toml
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
# Production SMTP (issue #85, executed with #29) — Resend, free tier, on the
# sending domain mail.tramitico.com (#327: a subdomain so SPF/DKIM never touch
# the apex MX records the privacidad@ forwarder needs). Only used by the
# hosted project's Auth settings; local dev keeps `supabase start`'s
# Inbucket/Mailpit capture regardless of these.
# Uncomment [auth.email.smtp] in supabase/config.toml before pushing to prod.
SMTP_PASS=
SMTP_ADMIN_EMAIL=
# Hosted auth email templates (#350) — `pnpm email:push` / `--check` PATCH the
# `mailer_templates_*` keys of the production project through the Management
# API, so the file in supabase/templates/ is what production sends. The token
# is a Supabase *personal access token* (dashboard → Account → Access Tokens):
# it can do anything your account can, so it lives in the gitignored
# `.env.prod` the deploy wizard writes, never in this file's local copy, never
# in CI. The ref is the production project's, same as the wizard captures.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
