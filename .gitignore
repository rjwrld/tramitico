# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prototype cache
__pycache__/
.playwright-mcp/
!.env.example
corpus/cache/

# vendored public cert (ADR 0001) — narrow carve-out from *.pem above, not a
# blanket un-ignore: this is a CA intermediate, never a private key.
!corpus/certs/globalsign-rsa-ov-ssl-ca-2018.pem

# playwright artifacts
/test-results/
/playwright-report/

# eval run transcripts (#289) — a measured run's answers, written by
# groundedness.eval.test.ts for the next classification read. Reporting
# output, not a committed artifact; eval.yml uploads them per run.
/eval/transcripts/

# Claude Code agent worktrees. The app's worktree isolation checks a second
# full copy of the tree out at `.claude/worktrees/<agent-id>`, inside the repo
# rather than beside it, so an unignored one shows up as a huge untracked
# directory and drags its own `docs/corpus-samples` and ingestion fixtures past
# .prettierignore — those patterns are root-anchored and do not match a nested
# copy. Orca's worktrees are siblings of the checkout and never land here.
.claude/worktrees/

# Codex CLI local state
.codex/

# Orca worktrees. Orca checks each branch out under a folder named after the
# project, and that folder lands inside the main checkout rather than beside
# it (`.orca-worktree-trash` marks it). Root-anchored: only the parent folder,
# not a future `src/tramitico/`.
/tramitico/

# Written by the Claude Code desktop app's preview tool; per-machine state.
.claude/launch.json
