# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prototype cache
__pycache__/
.playwright-mcp/
!.env.example
corpus/cache/

# vendored public cert (ADR 0001) — narrow carve-out from *.pem above, not a
# blanket un-ignore: this is a CA intermediate, never a private key.
!corpus/certs/globalsign-rsa-ov-ssl-ca-2018.pem

# playwright artifacts
/test-results/
/playwright-report/

# eval run transcripts (#289) — a measured run's answers, written by
# groundedness.eval.test.ts for the next classification read. Reporting
# output, not a committed artifact; eval.yml uploads them per run.
/eval/transcripts/
