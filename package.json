{
  "name": "tramitico",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": "24.x"
  },
  "license": "Apache-2.0",
  "scripts": {
    "dev": "next dev",
    "env:link": "bash scripts/link-env.sh",
    "build": "next build",
    "build:hermetic": "tsx scripts/hermetic-build.ts",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:eval": "vitest run --project eval",
    "test:db": "supabase test db --local",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:local": "playwright test --config=playwright.local.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ingest": "tsx scripts/ingest.ts",
    "recrawl": "bash scripts/recrawl.sh",
    "check:routing": "tsx scripts/check-routing-urls.ts",
    "canary": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/canary.ts",
    "pool-dump": "tsx scripts/pool-dump.ts",
    "answer-set-probe": "tsx scripts/answer-set-probe.ts",
    "cross-reference-census": "tsx scripts/cross-reference-census.ts",
    "answer-set-compare": "tsx scripts/answer-set-compare.ts",
    "requirement-coverage": "tsx scripts/requirement-coverage.ts",
    "tier1-miss-causes": "tsx scripts/tier1-miss-causes.ts",
    "carrier-recall": "tsx scripts/carrier-recall.ts",
    "answer-latency-probe": "tsx scripts/answer-latency-probe.ts",
    "prompt-tokens": "tsx scripts/prompt-tokens.ts",
    "answer-replay": "tsx scripts/answer-replay.ts",
    "absence-backtest": "tsx scripts/absence-backtest.ts",
    "hitrate-all-targets": "tsx scripts/hitrate-all-targets.ts",
    "icons": "tsx scripts/generate-icons.ts",
    "email:push": "tsx scripts/push-email-templates.ts",
    "email:preview": "tsx scripts/preview-email-templates.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.81",
    "@ai-sdk/react": "^4.0.146",
    "@base-ui/react": "^1.9.0",
    "@shadcn/react": "^0.3.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "ai": "^7.0.142",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "entities": "^8.1.0",
    "geist": "1.8.1",
    "lucide-react": "^1.58.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "undici": "^8.12.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ai-sdk/provider": "^4.0.28",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "shadcn": "^4.21.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^6",
    "vitest": "^5.0.5"
  }
